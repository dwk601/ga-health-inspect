# Local development: never use production credentials for scratch services.
# Coolify also requires DATABASE_URL (postgres:5432), REDIS_PASSWORD, and a
# separate 32-character PB_ENCRYPTION_KEY. Set these as secrets in Coolify.
# Use a strong URL-safe Redis password (unreserved letters, digits, -._~);
# Compose derives REDIS_URL from it. URL-encode credentials in DATABASE_URL.
APP_ENV=development
# AI is disabled unless both base URL (including /v1) and model are set.
# HTTPS and a server-only key are required remotely; explicit loopback may omit the key.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_TOKENS=1024
AI_MAX_INPUT_BYTES=24000
AI_DAILY_LIMIT=100
AI_MAX_INFLIGHT=4
# ETL_SCHEMA_PATH=/absolute/path/to/ga_health_inspect/schema.sql
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
APP_NAME="GA Health Inspect"
# Set the public origin used in verification emails.
APP_URL=
# Without SMTP_HOST, verification and password-reset emails are not sent.
# dev-api defaults to localhost and the dynamically published Mailpit SMTP port.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER_NAME=Georgia Health Inspect
SMTP_SENDER_ADDRESS=support@example.test
