# Local development: never use production credentials for scratch services.
# Coolify also requires DATABASE_URL (postgres:5432), REDIS_URL (redis:6379),
# REDIS_PASSWORD, and a separate 32-character PB_ENCRYPTION_KEY. Set these
# as secrets in Coolify; URL-encode credentials embedded in connection URLs.
# REDIS_URL and REDIS_PASSWORD must use the same strong password.
APP_ENV=development
# ETL_SCHEMA_PATH=/absolute/path/to/ga_health_inspect/schema.sql
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
APP_NAME="GA Health Inspect"
# Set the public origin used in verification emails.
APP_URL=
# dev-api defaults to the dynamically published Mailpit SMTP port.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER_NAME=Georgia Health Inspect
SMTP_SENDER_ADDRESS=support@example.test
